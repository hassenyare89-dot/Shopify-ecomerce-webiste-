# ---------------------------------------------------------------------------
# Environment variables — copy to .env for local development.
#   cp .env.example .env
# Production values are set in Shopify admin → Hydrogen → <storefront> →
# Storefront settings → Environments and variables (never commit secrets).
# Variables prefixed PUBLIC_ may be exposed to the browser. Everything else is
# server-only and must be marked "secret" in Oxygen.
# See docs/SHOPIFY_SETUP.md for where each value comes from.
# ---------------------------------------------------------------------------

# Required ------------------------------------------------------------------
# Random 32+ char string used to sign the session cookie (openssl rand -hex 32).
SESSION_SECRET=""
# Your store's permanent domain, e.g. your-store.myshopify.com
PUBLIC_STORE_DOMAIN=""
# Checkout domain (usually checkout.yourdomain.com or your-store.myshopify.com)
PUBLIC_CHECKOUT_DOMAIN=""
# Storefront API tokens from the Hydrogen (or Headless) sales channel.
PUBLIC_STOREFRONT_API_TOKEN=""
PRIVATE_STOREFRONT_API_TOKEN=""          # secret
PUBLIC_STOREFRONT_ID=""
# Customer Account API (Hydrogen channel → Customer Account API settings).
PUBLIC_CUSTOMER_ACCOUNT_API_CLIENT_ID=""
SHOP_ID=""

# Optional: newsletter ---------------------------------------------------------
# shopify = record consent in Shopify via Admin API (needs the token below)
# klaviyo = subscribe to a Klaviyo list
# none    = disable the signup endpoint
NEWSLETTER_PROVIDER="shopify"
# Custom app Admin API token with ONLY: read_customers, write_customers. Secret.
PRIVATE_ADMIN_API_TOKEN=""
SHOPIFY_STORE_MYSHOPIFY_DOMAIN=""        # e.g. your-store.myshopify.com
ADMIN_API_VERSION="2026-04"
KLAVIYO_PRIVATE_API_KEY=""               # secret (scope: subscriptions:write, lists:write)
KLAVIYO_LIST_ID=""

# Optional: contact form -------------------------------------------------------
# HTTPS endpoint receiving JSON submissions (helpdesk, Zapier, Make, Slack…).
CONTACT_FORM_WEBHOOK_URL=""              # secret (treat URL as a credential)

# Optional: webhooks -----------------------------------------------------------
# API secret key of the custom app that registers webhooks. Secret.
SHOPIFY_WEBHOOK_SECRET=""

# Optional: monitoring ---------------------------------------------------------
# HTTPS endpoint for structured error reports (e.g. Sentry/Datadog intake).
ERROR_WEBHOOK_URL=""                     # secret

# Optional: privacy & analytics (all consent-gated) ------------------------------
# "true" to show Shopify's cookie banner (configure in Settings → Customer privacy).
PUBLIC_PRIVACY_BANNER="true"
PUBLIC_GA4_MEASUREMENT_ID=""             # G-XXXXXXX
PUBLIC_GTM_CONTAINER_ID=""               # GTM-XXXXXX
PUBLIC_META_PIXEL_ID=""
PUBLIC_TIKTOK_PIXEL_ID=""
PUBLIC_PINTEREST_TAG_ID=""
PUBLIC_KLAVIYO_COMPANY_ID=""             # Klaviyo public site ID (onsite forms)
