# MOCK ENVIRONMENT — local development & automated tests only.
# Points the storefront at the local mock Storefront API (npm run mock:api).
# These values are NOT secrets and NOT real Shopify credentials.
SESSION_SECRET="mock-session-secret-not-for-production"
PUBLIC_STORE_DOMAIN="http://127.0.0.1:4010"
PUBLIC_CHECKOUT_DOMAIN="127.0.0.1:4010"
PUBLIC_STOREFRONT_API_TOKEN="mockpublictoken00000000000000000"
PRIVATE_STOREFRONT_API_TOKEN="mock-private-token"
PUBLIC_STOREFRONT_ID="1"
PUBLIC_CUSTOMER_ACCOUNT_API_CLIENT_ID="mock-customer-account-client-id"
SHOP_ID="1"
NEWSLETTER_PROVIDER="none"
