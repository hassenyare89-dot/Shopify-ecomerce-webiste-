{
  "name": "storefront",
  "private": true,
  "sideEffects": false,
  "version": "2026.4.9",
  "type": "module",
  "scripts": {
    "dev": "shopify hydrogen dev --codegen",
    "dev:mock": "concurrently -k -n mock,app \"npm:mock:api\" \"shopify hydrogen dev --codegen --env-file mock/mock.env --port 3000\"",
    "setup:env": "node scripts/setup-env.mjs",
    "mock:api": "node mock/storefront-server.mjs",
    "build": "shopify hydrogen build --codegen",
    "preview": "shopify hydrogen preview --build",
    "preview:mock": "shopify hydrogen preview --env-file mock/mock.env --port 3000",
    "lint": "eslint --no-error-on-unmatched-pattern .",
    "typecheck": "react-router typegen && tsc --noEmit",
    "codegen": "shopify hydrogen codegen && react-router typegen",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --trace off",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "prettier": "@shopify/prettier-config",
  "dependencies": {
    "@shopify/hydrogen": "2026.4.8",
    "graphql": "^16.10.0",
    "graphql-tag": "^2.12.6",
    "isbot": "^5.1.22",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "7.18.5",
    "react-router-dom": "7.18.5",
    "tailwindcss": "^4.1.6",
    "three": "^0.183.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/compat": "^2.1.1",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^10.0.1",
    "@graphql-codegen/cli": "8.0.0",
    "@graphql-tools/mock": "^10.1.4",
    "@graphql-tools/schema": "^11.0.9",
    "@playwright/test": "^1.65.0",
    "@react-router/dev": "8.5.1",
    "@react-router/fs-routes": "8.5.1",
    "@shopify/cli": "5.0.1",
    "@shopify/hydrogen-codegen": "0.3.3",
    "@shopify/mini-oxygen": "4.2.3",
    "@shopify/oxygen-workers-types": "^4.1.6",
    "@shopify/prettier-config": "^1.1.2",
    "@tailwindcss/vite": "^4.3.5",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/eslint": "^9.6.1",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.183.1",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.21.0",
    "concurrently": "^10.0.7",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jest": "^29.17.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "graphql-config": "^6.0.0",
    "prettier": "^3.4.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": "^22 || ^24"
  },
  "browserslist": [
    "defaults"
  ],
  "overrides": {
    "react-router": "7.18.5",
    "react-router-dom": "7.18.5",
    "@react-router/dev": "8.5.1",
    "@react-router/fs-routes": "8.5.1",
    "@react-router/node": "7.18.5",
    "lodash": "^4.17.24",
    "esbuild": "^0.28.2"
  }
}
